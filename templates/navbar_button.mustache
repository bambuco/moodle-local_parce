{{!
    @template local_parce/navbar_button

    Navbar button that opens the docked chat drawer.

    Example context (json):
    {
        "icon": "icons/robot"
    }
}}
<div class="popover-region collapsed d-flex align-items-center" data-region="popover-region-local_parce">
    <button type="button"
        id="local_parce-chat-toggle"
        class="nav-link popover-region-toggle icon-no-margin local_parce-chat-bubble local_parce-nav-toggle"
        aria-label="{{#str}}chat_bubble_label, local_parce{{/str}}"
        aria-expanded="false">
        {{#pix}} {{icon}}, local_parce, {{#str}}chat_bubble_label, local_parce{{/str}} {{/pix}}
    </button>
</div>
