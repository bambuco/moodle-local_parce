{{!
    @template local_parce/chat_bubble

    Floating chat bubble for local_parce.

    Example context (json):
    {
        "chat_title": "Chat with Parce",
        "icon": "icons/robot",
        "floating": true
    }
}}
<div id="local_parce-chat-container" data-placement="floating">
    <button type="button"
        id="local_parce-chat-toggle"
        class="local_parce-chat-bubble"
        aria-label="{{#str}}chat_bubble_label, local_parce{{/str}}"
        aria-controls="local_parce-chat-window-container"
        aria-expanded="false">
        <span class="local_parce-bubble-icon">
            {{#pix}} {{icon}}, local_parce, {{#str}}chat_bubble_label, local_parce{{/str}} {{/pix}}
        </span>
    </button>
    {{> local_parce/chat_window }}
    {{> local_parce/chat_snippets }}
</div>
