{{!
    @template local_parce/chat_bubble

    Floating chat bubble template for local_parce

    Example context (json):
    {
        "chat_title": "Chat with Parce"
    }
}}

<div id="local_parce-chat-container">
    <div class="local_parce-chat-bubble" role="button" tabindex="0" aria-label="{{#str}}chat_bubble_label, local_parce{{/str}}">
        <div class="local_parce-bubble-icon">
            {{#pix}} chat, local_parce {{/pix}}
        </div>
    </div>
    <div id="local_parce-chat-window-container" aria-hidden="true">
        <div class="local_parce-chat-window">
            <div class="local_parce-chat-header">
                <h4 class="local_parce-chat-title">{{chat_title}}</h4>
                <button class="btn btn-sm btn-link local_parce-close-btn" aria-label="{{#str}} aria_close_chat, local_parce {{/str}}">
                    {{#pix}} i/window_close {{/pix}}
                </button>
            </div>
            <div id="local_parce-messages-container" class="local_parce-chat-messages">
                <div class="local_parce-message-welcome">
                    <p>
                        {{#str}} chat_welcome, local_parce {{/str}}
                    </p>
                </div>
            </div>
            <div class="local_parce-chat-footer">
                <textarea class="form-control local_parce-message-input"
                    placeholder="{{#str}} placeholder, local_parce {{/str}}"
                    aria-label="{{#str}} aria_message_input, local_parce {{/str}}"></textarea>
                <button class="local_parce-send-btn btn btn-primary" aria-label="{{#str}} chat_send, local_parce {{/str}}" title="{{#str}} chat_send, local_parce {{/str}}">
                    {{#pix}} i/sendmessage {{/pix}}
                </button>
            </div>
        </div>
    </div>
    <div class="local_parce-message local_parce-message-loading hidden" aria-label="{{#str}} aria_loading, local_parce {{/str}}">
        <div class="local_parce-message-content" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span>{{#str}} chat_loading, local_parce {{/str}}</span>
        </div>
    </div>
    <div class="local_parce-message-welcome hidden"><p>{{#str}} chat_welcome, local_parce {{/str}}</p></div>
</div>