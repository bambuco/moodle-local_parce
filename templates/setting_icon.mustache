{{!
    @template local_parce/setting_icon

    Icon picker for the chat open button.

    Example context (json):
    {
        "id": "id_s_local_parce_buttonicon",
        "name": "s_local_parce_buttonicon",
        "currenturl": "http://example.com/robot.svg",
        "currentlabel": "robot",
        "grouplabel": "Button icon",
        "readonly": false,
        "icons": [
            {
                "value": "robot",
                "label": "robot",
                "url": "http://example.com/robot.svg",
                "selected": true
            }
        ]
    }
}}
<div class="local-parce-iconpicker dropdown">
    <button type="button"
        id="{{id}}"
        class="btn btn-outline-secondary dropdown-toggle local-parce-iconpicker-toggle"
        data-bs-toggle="dropdown"
        data-bs-auto-close="true"
        aria-expanded="false"
        {{#readonly}}disabled{{/readonly}}>
        <img src="{{currenturl}}" alt="" class="local-parce-iconpicker-current" width="24" height="24">
        <span class="local-parce-iconpicker-label">{{currentlabel}}</span>
    </button>
    <div class="dropdown-menu local-parce-iconpicker-menu" role="radiogroup" aria-label="{{grouplabel}}">
        {{#icons}}
            <label class="local-parce-iconpicker-option">
                <input type="radio"
                    name="{{name}}"
                    value="{{value}}"
                    {{#selected}}checked{{/selected}}
                    {{#readonly}}disabled{{/readonly}}>
                <img src="{{url}}" alt="" width="24" height="24">
                <span>{{label}}</span>
            </label>
        {{/icons}}
    </div>
</div>
