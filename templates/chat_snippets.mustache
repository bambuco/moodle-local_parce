{{!
    @template local_parce/chat_snippets

    Hidden source nodes cloned into the live conversation.

    Example context (json):
    {}
}}
<div class="local_parce-message-welcome hidden">
    <p>{{#str}} chat_welcome, local_parce {{/str}}</p>
    {{^sitelevel}}
    <label class="form-check form-switch local_parce-global-switch">
        <input type="checkbox" class="form-check-input local_parce-global-context" role="switch">
        <span class="form-check-label">{{#str}} globalcontext, local_parce {{/str}}</span>
    </label>
    {{/sitelevel}}
</div>
<div class="local_parce-conversation-notice hidden">
    {{#str}} conversation_started, local_parce {{/str}}
</div>
<div class="local_parce-status-texts hidden" aria-hidden="true">
    <span data-key="loading">{{#str}} chat_loading, local_parce {{/str}}</span>
    <span data-key="historyerror">{{#str}} chat_history_error, local_parce {{/str}}</span>
    <span data-key="empty">{{#str}} chat_empty, local_parce {{/str}}</span>
    <span data-key="retry">{{#str}} chat_retry, local_parce {{/str}}</span>
</div>
